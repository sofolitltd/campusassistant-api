# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=disable

# ─── Server ─────────────────────────────────────────────
PORT=8080
ENVIRONMENT=development

# ─── Cloudflare R2 Storage ──────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_PUBLIC_URL=

# ─── API Security ───────────────────────────────────────
# X-API-Key is a shared secret shipped inside client apps, so it only
# identifies a client — it cannot secure anything. Per-route JWT policies
# (ACCESS_ENFORCE) and rate limits are the real protection.
# Rollout to drop the key from the mobile app: deploy -> set ACCESS_ENFORCE=true
# and API_KEY_REQUIRED=false -> ship app builds without the key. The server
# refuses to start with API_KEY_REQUIRED=false and ACCESS_ENFORCE=false
# outside development. The admin dashboard's server-side proxy keeps sending
# the key either way, so keep API_KEY set.
API_KEY=change-this-to-a-strong-random-key
API_KEY_REQUIRED=true
ACCESS_ENFORCE=false

# Browser origins allowed to call the API (comma-separated, exact origins).
# BKASH_CALLBACK_BASE_URL's origin is always allowed; mobile apps send no
# Origin and are unaffected. localhost is allowed automatically in development.
CORS_ALLOWED_ORIGINS=

# Proxy IPs/CIDRs whose X-Forwarded-For is trusted (your reverse proxy / Coolify
# network). Rate limits key on client IP — leave this unset and it can be spoofed.
TRUSTED_PROXIES=

# In-memory per-instance rate limits, requests/minute (0 disables).
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PAY_PER_MINUTE=30

# ─── SMTP (password reset emails) ───────────────────────
# Gmail: enable 2FA on the account, then Google Account → Security →
# App Passwords → generate one for "Mail". Use that 16-character value as
# SMTP_PASSWORD (not the account's normal password). Free Gmail allows
# roughly 500 messages/day, which is ample for password resets.
# If SMTP_HOST/USERNAME/PASSWORD are left blank, emails are written to the
# server log instead of being sent — fine for local dev, useless in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Campus Assistant

# ─── GORM Auto-Migrate ──────────────────────────────────
DB_AUTO_MIGRATE=true

# ─── JWT Authentication ─────────────────────────────────
JWT_SECRET=change-this-to-a-32-character-plus-secret-key
JWT_ACCESS_TOKEN_EXPIRY=15    # minutes
JWT_REFRESH_TOKEN_EXPIRY=168  # hours (7 days)

# ─── Firebase Cloud Messaging (push notifications) ──────
# Either point to a downloaded service-account JSON file (default path below
# works if you drop the file at the repo root), or set FIREBASE_CREDENTIALS_JSON
# with the raw file contents on hosts where you can't mount a file. Push is
# silently disabled if neither is set/found.
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=

# ─── bKash Tokenized Checkout ────────────────────────────
# BKASH_PRODUCTION is the single, server-side switch between sandbox and
# production — the app never decides this. Leave false (or unset) to always
# use bKash's shared public sandbox credentials below (safe defaults, never
# real money). Only set BKASH_PROD_* and flip BKASH_PRODUCTION=true when
# ready to take real payments — and never tap/click your own production
# payment flow outside of a real test purchase.
BKASH_PRODUCTION=false
BKASH_SANDBOX_USERNAME=sandboxTokenizedUser02
BKASH_SANDBOX_PASSWORD=sandboxTokenizedUser02@12345
BKASH_SANDBOX_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_SANDBOX_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_PROD_USERNAME=
BKASH_PROD_PASSWORD=
BKASH_PROD_APP_KEY=
BKASH_PROD_APP_SECRET=
# Where bKash redirects the user's browser/WebView after payment — the
# Flutter web app's origin (its /payment route lives at <this>/payment).
BKASH_CALLBACK_BASE_URL=https://campusassistant.web.app
