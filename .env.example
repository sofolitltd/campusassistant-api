# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=disable

# ─── Server ─────────────────────────────────────────────
PORT=8080
ENVIRONMENT=development

# ─── Cloudflare R2 Storage ──────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_PUBLIC_URL=

# ─── API Security (X-API-Key header) ────────────────────
API_KEY=change-this-to-a-strong-random-key

# ─── GORM Auto-Migrate ──────────────────────────────────
DB_AUTO_MIGRATE=true

# ─── JWT Authentication ─────────────────────────────────
JWT_SECRET=change-this-to-a-32-character-plus-secret-key
JWT_ACCESS_TOKEN_EXPIRY=15    # minutes
JWT_REFRESH_TOKEN_EXPIRY=168  # hours (7 days)

# ─── Firebase Cloud Messaging (push notifications) ──────
# Either point to a downloaded service-account JSON file (default path below
# works if you drop the file at the repo root), or set FIREBASE_CREDENTIALS_JSON
# with the raw file contents on hosts where you can't mount a file. Push is
# silently disabled if neither is set/found.
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
